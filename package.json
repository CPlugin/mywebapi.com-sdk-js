{
  "name": "@mywebapi.com/sdk",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Typed TypeScript SDK for the CPlugin WebAPI v2 — manage trading-platform servers from Node.js and browsers. OAuth2, retries, pagination and SignalR real-time included; types regenerated from the OpenAPI spec so they never drift.",
  "type": "module",
  "main": "./dist/node/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "node": "./dist/node/index.js",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CPlugin/mywebapi.com-sdk-js.git"
  },
  "homepage": "https://cplugin.github.io/mywebapi.com-sdk-js/",
  "keywords": [
    "cplugin",
    "webapi",
    "trading",
    "trading-platform",
    "broker",
    "forex",
    "sdk",
    "typescript",
    "api-client",
    "rest-api",
    "openapi",
    "signalr",
    "real-time",
    "oauth2"
  ],
  "bugs": {
    "url": "https://github.com/CPlugin/mywebapi.com-sdk-js/issues"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "build": "rm -rf dist && mkdir -p dist/node dist/browser && bun build src/index.ts --outdir dist/node --target node --format esm --external @microsoft/signalr && bun build src/index.ts --outdir dist/browser --target browser --format esm --external @microsoft/signalr && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration",
    "test": "bun test",
    "test:e2e": "WEBAPI_E2E=1 bun test e2e",
    "docs": "typedoc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "orval": "8.19.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.4.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.0"
  }
}
